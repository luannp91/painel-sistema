<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <?define ProductName = "Painel do Sistema"?>
  <?define ProductVersion = "0.2.0"?>
  <?define Manufacturer = "Luann P."?>
  <?define UpgradeCode = "8f8c4a1b-3e2f-4c9d-a1b5-7e9f2c8d5a3b"?>
  <?define ExeName = "painel-sistema.exe"?>

  <Product
      Id="*"
      Name="$(var.ProductName)"
      Language="1046"
      Version="$(var.ProductVersion)"
      Manufacturer="$(var.Manufacturer)"
      UpgradeCode="$(var.UpgradeCode)">

    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perMachine"
        Description="Agente nativo + painel web de informações do sistema"
        Comments="Painel do Sistema © 2026 Luann P."/>

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="Uma versão mais recente já está instalada."/>

    <MediaTemplate EmbedCab="yes"/>

    <!-- Ícone e metadados -->
    <Icon Id="AppIcon" SourceFile="..\web\assets\icons\favicon.ico"/>
    <Property Id="ARPPRODUCTICON" Value="AppIcon"/>
    <Property Id="ARPHELPLINK" Value="https://github.com/luannp91/painel-sistema"/>
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/luannp91/painel-sistema"/>

    <!-- Adiciona ao PATH (opcional, para usar via CLI) -->
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER"/>
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="O painel estará disponível em http://localhost:8080"/>

    <!-- Interface padrão do instalador -->
    <UIRef Id="WixUI_InstallDir"/>
    <WixVariable Id="WixUILicenseRtf" Value="LICENSE.rtf"/>

    <!-- Estrutura de diretórios -->
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Painel do Sistema"/>
      </Directory>

      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Painel do Sistema"/>
      </Directory>

      <Directory Id="DesktopFolder"/>
    </Directory>

    <!-- Arquivos do programa -->
    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="*">
        <File
            Id="PainelExe"
            Source="..\target\release\$(var.ExeName)"
            KeyPath="yes"
            Vital="yes">
          <Shortcut Id="AppShortcut"
                    Directory="ApplicationProgramsFolder"
                    Name="Painel do Sistema"
                    Description="Abrir o painel no navegador"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes"/>

          <Shortcut Id="DesktopShortcut"
                    Directory="DesktopFolder"
                    Name="Painel do Sistema"
                    Description="Abrir o painel no navegador"
                    WorkingDirectory="INSTALLFOLDER"
                    Advertise="yes"/>
        </File>
      </Component>

      <!-- Config default (não sobrescreve se já existir) -->
      <Component Id="DefaultConfig" Guid="*">
        <File Id="ConfigToml"
              Source="..\config.toml"
              KeyPath="yes"
              Vital="no">
          <util:PermissionEx User="Everyone" GenericRead="yes" GenericWrite="yes"
              xmlns:util="http://schemas.microsoft.com/wix/UtilExtension"/>
        </File>
      </Component>
    </DirectoryRef>

    <!-- Atalhos no menu iniciar -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut Id="AppMenuShortcut"
                  Name="Painel do Sistema"
                  Description="Iniciar o agente"
                  Target="[#PainelExe]"
                  WorkingDirectory="INSTALLFOLDER"/>

        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\LuannP\PainelSistema"
                       Name="installed" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <!-- Marca para o Windows saber que pode usar o Uninstall -->
    <Feature Id="ProductFeature" Title="Painel do Sistema" Level="1">
      <ComponentRef Id="MainExecutable"/>
      <ComponentRef Id="DefaultConfig"/>
      <ComponentRef Id="ApplicationShortcut"/>
    </Feature>

    <!-- Instalar/desinstalar como serviço (opcional, via sc.exe) -->
    <CustomAction Id="InstallService"
                  Directory="INSTALLFOLDER"
                  ExeCommand='sc create PainelSistema binPath= "[#PainelExe] --port 8080" start= auto'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <CustomAction Id="StartService"
                  Directory="INSTALLFOLDER"
                  ExeCommand='sc start PainelSistema'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <CustomAction Id="StopAndDeleteService"
                  Directory="INSTALLFOLDER"
                  ExeCommand='cmd /c sc stop PainelSistema &amp; sc delete PainelSistema'
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <InstallExecuteSequence>
      <Custom Action="InstallService" After="InstallFiles">
        NOT Installed AND NOT REMOVE
      </Custom>
      <Custom Action="StartService" After="InstallService">
        NOT Installed AND NOT REMOVE
      </Custom>
      <Custom Action="StopAndDeleteService" Before="RemoveFiles">
        REMOVE~="ALL"
      </Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
